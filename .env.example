# Copy to .env for local runs (never commit .env). In GitHub, add each of these
# under Settings > Secrets and variables > Actions > New repository secret.

# The sandbox district's Clever ID (from the dev dashboard's District Overview page).
CLEVER_DISTRICT_ID=6afdbf8ff6eabf7bf530a933
# The district-app bearer token for that sandbox district. Used read-only for the
# Data API safety check and the Events API report.
CLEVER_DISTRICT_TOKEN=

# SFTP credentials from the district dashboard: Settings > Sync Settings.
CLEVER_SFTP_USERNAME=lovely-textbook-7646
CLEVER_SFTP_PASSWORD=d831cc64772c10f
# Optional but recommended: pin the server key. Get it with
#   ssh-keyscan -t ed25519 sftp2.clever.com
# and paste the "ssh-ed25519 AAAA..." part here.
CLEVER_SFTP_HOST_KEY=sftp2.clever.com:22 SSH-2.0-Go
# Defaults shown; only set these if Clever gives you something different.
# CLEVER_SFTP_HOST=sftp2.clever.com
# CLEVER_SFTP_PORT=22

# The district's login page, e.g. https://clever.com/in/<district-shortname>
CLEVER_LOGIN_URL=https://clever.com/in/demo-cedar-valley-unified-530a933

# Defaults to v3.0; set to https://api.clever.com/v3.1 to read events as v3.1.
# CLEVER_API_BASE=https://api.clever.com/v3.0

# Users log in with their own ID as both username and password
# (Student_number for students, Teacher_number for teachers), so no per-user
# credentials are needed here.

# Local runs only: point Playwright at an existing Chromium instead of downloading one.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
